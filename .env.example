# 应用
APP_NAME=customer-agent2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# 简单认证（P0 可关闭；公开部署时必须开启）
AUTH_ENABLED=false
API_KEY=

# 阿里云百炼 Chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_FINAL=qwen3.7-max-preview
CHAT_MODEL_FAST=qwen3.7-flash
LLM_TIMEOUT_SECONDS=100
LLM_FIRST_PACKET_TIMEOUT_SECONDS=30
RAG_GLOBAL_TIMEOUT_SECONDS=120
MEMORY_RECENT_TURNS=6
MEMORY_SUMMARY_TRIGGER_TURNS=12
MEMORY_SUMMARY_TIMEOUT_SECONDS=30
MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=512
QUERY_REWRITE_TIMEOUT_SECONDS=20
QUERY_REWRITE_MAX_OUTPUT_TOKENS=512
QUERY_REWRITE_MAX_SUB_QUESTIONS=3
INTENT_HIGH_CONFIDENCE_THRESHOLD=0.75
INTENT_AMBIGUITY_MARGIN=0.10
INTENT_TIMEOUT_SECONDS=20
INTENT_MAX_OUTPUT_TOKENS=256

# 本地 Embedding Baseline
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
LOCAL_EMBEDDING_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65
LOCAL_EMBEDDING_DIMENSION=768
LOCAL_EMBEDDING_MAX_TOKENS=512
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

# Rerank：启用 qwen3-rerank 前需要填写业务空间 ID
RERANK_ENABLED=false
RERANK_PROVIDER=dashscope
RERANK_MODEL=qwen3-rerank
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_RERANK_REGION=cn-beijing
RERANK_TIMEOUT_SECONDS=10

# VLM（P1）
VLM_ENABLED=false
VLM_MODEL=qwen3.7-plus

# PostgreSQL + pgvector
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm
POSTGRES_DB=customer_agent2
POSTGRES_USER=customer_agent2
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://customer_agent2:change_me@127.0.0.1:5432/customer_agent2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=customer-agent2
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# 就绪检查（PostgreSQL、pgvector、Redis 单项超时）
READINESS_TIMEOUT_SECONDS=3

# 检索漏斗
RETRIEVAL_RECALL_BUDGET=20
RETRIEVAL_HNSW_EF_SEARCH=100
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATE_LIMIT=40
RETRIEVAL_CONTEXT_TOP_K=10
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2

# 分块
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=64
UPLOAD_MAX_FILE_MB=50
DOCUMENT_MAX_EXTRACTED_CHARS=5000000
DOCUMENT_MAX_PDF_PAGES=1000
DOCUMENT_MAX_DOCX_ENTRIES=2000
DOCUMENT_MAX_DOCX_UNCOMPRESSED_MB=200
DOCUMENT_MAX_DOCX_EXPANSION_RATIO=100
DOCUMENT_MAX_CSV_ROWS=10000
DOCUMENT_MAX_CSV_COLUMNS=200

# 会话记忆
MEMORY_RECENT_TURNS=6
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_START_TURNS=8
MEMORY_SUMMARY_MAX_CHARS=400

# S3-compatible 对象存储（P0 早期可关闭）
OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=customer-agent2

# MCP（P1）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9099/mcp

# Trace 与评测
TRACE_ENABLED=true
EVALUATION_ENABLED=true
